# ClauseGuard Environment Configuration Example
# Copy this file to .env for local overrides if required.
# Note: ClauseGuard runs completely client-side in-memory by default with zero mandatory API keys.

# Optional: Google Gemini API Key for Live Generative Q&A & Simplification
# You can also configure this directly in the application UI via the "AI Mode" key button.
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
VITE_APP_NAME="ClauseGuard"
VITE_APP_TAGLINE="Understand your document. Spot what matters. Prepare for the next step."
